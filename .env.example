# Copy to .env for local development (`npx vercel env pull` fills it from Vercel).
# Never commit real values. Set production and preview values in Vercel → Project → Settings → Environment Variables.

# Store (already set on the Vercel project). Use a Stripe test key (sk_test_…) for Preview and local.
STRIPE_SECRET_KEY=
# Signing secret (whsec_…) of the Stripe webhook that emails buyers their download links.
# Stripe Dashboard → Developers → Webhooks → endpoint https://www.matthewmenardmusic.com/api/stripe-webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded. Use a test-mode endpoint for Preview.
STRIPE_WEBHOOK_SECRET=

# Email through Resend: contact and commission forms, and the download-link email to buyers
RESEND_API_KEY=
COMMISSION_TO_EMAIL=
COMMISSION_FROM_EMAIL=

# Website care: client alteration requests (/alterations) and the private tracker (/admin).
# Storage: Vercel → Storage → Upstash for Redis, connected to this project, sets these two.
# Locally, leave them empty and requests are kept in memory until the dev server stops.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Password for /admin, and a random secret (at least 32 characters) that signs the sign-in cookie.
# Make the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
